# ---- Секреты и доступы ----
# Kubeconfig'и стенда: содержат клиентские сертификаты кластеров
*.kubeconfig
kubeconfig*
.kube/
*.pem
*.key
*.crt
.env
.env.*
!.env.example
secrets/

# ---- Go ----
bin/
dist/
*.exe
*.test
*.out
vendor/

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---- Локальные настройки Claude Code ----
# settings.json коммитится (общие правила команды),
# settings.local.json - нет (личные настройки)
.claude/settings.local.json

# ---- Редакторы ----
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-*

# ---- macOS ----
.DS_Store
.AppleDouble
._*

# ---- Терраформ, если появится ----
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# ---- Стенд ----
# Временные артефакты kind/k3d
.kind-cache/
stand/**/generated/

# ---- Примеры чужих ВКР от руководителя: только для чтения, не публикуем ----
ВКР-*.pdf
Отчёт_НИР_*.pdf

# ---- Что НЕ игнорируем намеренно ----
# experiments/results/ - сырые данные прогонов, основной результат НИР.
# Коммитятся всегда, даже если крупные. См. CLAUDE.md.

# ---- Сборка ВКР (make thesis) ----
docs/nir/thesis/build/
# вспомогательные файлы LaTeX, если сборка шла мимо build/ (LaTeX Workshop)
docs/nir/thesis/*.aux
docs/nir/thesis/*.log
docs/nir/thesis/*.fls
docs/nir/thesis/*.fdb_latexmk
docs/nir/thesis/*.synctex.gz
docs/nir/thesis/*.toc
docs/nir/thesis/*.out
docs/nir/thesis/*.pdf
